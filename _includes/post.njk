<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — GWAP Gang</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://gwapgang.com{{ page.url }}">
  <style>
    :root { color-scheme: dark; --bg:#050706; --panel:#0b0f0d; --text:#f3f7f4; --muted:#9aa79f; --line:#1d2b23; --accent:#38ff88; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font:17px/1.75 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:var(--accent); }
    .shell { width:min(920px,calc(100% - 32px)); margin:auto; }
    header { padding:28px 0; border-bottom:1px solid var(--line); }
    .brand { color:var(--accent); text-decoration:none; font-weight:900; letter-spacing:.12em; }
    article { padding:64px 0 80px; }
    .eyebrow { color:var(--accent); font-size:.78rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
    h1 { max-width:850px; margin:12px 0 16px; font-size:clamp(2.2rem,7vw,4.8rem); line-height:1.02; letter-spacing:-.045em; }
    .meta { color:var(--muted); margin-bottom:32px; }
    .hero { width:100%; max-height:560px; object-fit:cover; border:1px solid var(--line); border-radius:18px; margin:10px 0 42px; }
    .body { max-width:760px; }
    .body h2,.body h3 { line-height:1.15; margin-top:2.1em; }
    .body img { max-width:100%; height:auto; border-radius:14px; }
    .body blockquote { margin-left:0; padding-left:20px; border-left:3px solid var(--accent); color:#d5ddd8; }
    .back { display:inline-block; margin-top:48px; text-decoration:none; font-weight:700; }
    footer { padding:28px 0 50px; color:var(--muted); border-top:1px solid var(--line); font-size:.9rem; }
  </style>
</head>
<body>
  <header><div class="shell"><a class="brand" href="/">GWAP GANG</a></div></header>
  <main class="shell">
    <article>
      <div class="eyebrow">GWAP Intelligence</div>
      <h1>{{ title }}</h1>
      <div class="meta">By {{ author }} · {{ date | readableDate }}</div>
      {% if image %}<img class="hero" src="{{ image }}" alt="{{ title }}">{% endif %}
      <div class="body">{{ content | safe }}</div>
      <a class="back" href="/blog/">← Back to GWAP Blog</a>
    </article>
  </main>
  <footer><div class="shell">© 2026 GWAP Gang. Build. Ship. Get Paid.</div></footer>
</body>
</html>
