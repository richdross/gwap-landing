<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set canonicalUrl = canonical or (site.url + page.url) %}
  {% set heroImage = image or site.defaultImage %}
  {% set heroImageUrl = heroImage | absoluteUrl(site.url) %}
  {% set modifiedDate = updated or date %}
  {% set articleCategory = category or "Gwap Intelligence" %}
  {% set articleSectionSlug = section or "intelligence" %}
  {% if articleSectionSlug == "culture" %}
    {% set articleSectionName = "Culture" %}
  {% elif articleSectionSlug == "capital" %}
    {% set articleSectionName = "Capital" %}
  {% elif articleSectionSlug == "technology" %}
    {% set articleSectionName = "Technology" %}
  {% else %}
    {% set articleSectionSlug = "intelligence" %}
    {% set articleSectionName = "Intelligence" %}
  {% endif %}
  {% set intelligenceKeywords = articleSectionName | graphKeywords(articleCategory, topics, entities, technologies, businessModels) %}
  {% set intelligenceAbout = entities | graphAbout(technologies) %}

  <title>{{ title }} — Gwap Gang</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <meta name="author" content="{{ author }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="alternate" type="application/rss+xml" title="Gwap Intelligence RSS" href="{{ site.url }}{{ site.rssPath }}">

  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Gwap Gang">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ heroImageUrl }}">
  <meta property="og:image:alt" content="{{ imageAlt or title }}">
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:modified_time" content="{{ modifiedDate | isoDate }}">
  <meta property="article:author" content="{{ author }}">
  <meta property="article:section" content="{{ articleSectionName }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ heroImageUrl }}">
  <meta name="twitter:image:alt" content="{{ imageAlt or title }}">

  {% if site.preferredSourcesEnabled %}
  <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
  {% endif %}

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MZF7SR86XK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-MZF7SR86XK', { page_path: '{{ page.url }}' });
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": "Gwap Gang",
        "url": "{{ site.url }}/",
        "email": "{{ site.email }}",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "{{ site.contactPoint.contactType }}",
          "email": "{{ site.contactPoint.email }}"
        },
        "logo": {
          "@type": "ImageObject",
          "url": "{{ site.publisherLogo | absoluteUrl(site.url) }}"
        }
      },
      {
        "@type": "Person",
        "@id": "{{ authorUrl | absoluteUrl(site.url) }}#person",
        "name": {{ author | json | safe }},
        "url": "{{ authorUrl | absoluteUrl(site.url) }}",
        "jobTitle": {{ authorRole | json | safe }},
        "worksFor": { "@id": "{{ site.url }}/#organization" }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "{{ canonicalUrl }}#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Gwap Gang",
            "item": "{{ site.url }}/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ articleSectionName | json | safe }},
            "item": "{{ site.url }}/{{ articleSectionSlug }}/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | json | safe }},
            "item": "{{ canonicalUrl }}"
          }
        ]
      },
      {
        "@type": "BlogPosting",
        "@id": "{{ canonicalUrl }}#article",
        "url": "{{ canonicalUrl }}",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ canonicalUrl }}"
        },
        "headline": {{ title | json | safe }},
        "description": {{ description | json | safe }},
        "image": ["{{ heroImageUrl }}"],
        "datePublished": {{ date | isoDate | json | safe }},
        "dateModified": {{ modifiedDate | isoDate | json | safe }},
        "articleSection": {{ articleSectionName | json | safe }},
        "keywords": {{ intelligenceKeywords | json | safe }},
        {% if intelligenceAbout.length %}"about": {{ intelligenceAbout | json | safe }},{% endif %}
        "author": { "@id": "{{ authorUrl | absoluteUrl(site.url) }}#person" },
        "publisher": { "@id": "{{ site.url }}/#organization" },
        "breadcrumb": { "@id": "{{ canonicalUrl }}#breadcrumbs" }
      }
    ]
  }
  </script>

  <style>
    :root {
      color-scheme: dark;
      --bg:#050706;
      --panel:#0b0f0d;
      --panel2:#0f1511;
      --text:#f3f7f4;
      --muted:#9aa79f;
      --line:#1d2b23;
      --accent:#38ff88;
      --soft:#d8e0db;
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      margin:0;
      background:var(--bg);
      color:var(--text);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }
    a { color:var(--accent); }
    button { font:inherit; }
    .reading-progress {
      position:fixed;
      top:0;
      left:0;
      z-index:100;
      width:0;
      height:3px;
      background:var(--accent);
      box-shadow:0 0 18px rgba(56,255,136,.4);
    }
    .shell { width:min(1120px,calc(100% - 32px)); margin:auto; }
    .reading-shell { width:min(820px,100%); }
    header { padding:24px 0; border-bottom:1px solid var(--line); }
    .brand { color:var(--accent); text-decoration:none; font-weight:900; letter-spacing:.14em; font-size:.82rem; }
    .breadcrumbs { padding:22px 0 0; color:var(--muted); font-size:.82rem; }
    .breadcrumbs a { color:var(--muted); text-decoration:none; }
    .breadcrumbs a:hover { color:var(--accent); }
    article { padding:42px 0 96px; }
    .eyebrow { display:flex; flex-wrap:wrap; align-items:center; gap:.55em; color:var(--accent); font-size:.76rem; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }
    .eyebrow .section-link { color:var(--accent); text-decoration:none; border-bottom:1px solid rgba(56,255,136,.38); padding-bottom:3px; }
    .eyebrow .section-link:hover { color:#fff; border-color:var(--accent); }
    .eyebrow .topic-label { color:var(--muted); letter-spacing:.12em; }
    article > h1 {
      max-width:980px;
      margin:14px 0 18px;
      font-size:clamp(2.65rem,7vw,5.8rem);
      line-height:.98;
      letter-spacing:-.052em;
      text-wrap:balance;
    }
    .dek {
      max-width:800px;
      margin:0 0 22px;
      color:var(--soft);
      font-size:clamp(1.05rem,2.2vw,1.28rem);
      line-height:1.6;
    }
    .meta {
      display:flex;
      flex-wrap:wrap;
      gap:10px 18px;
      align-items:center;
      color:var(--muted);
      margin-bottom:38px;
      font-size:.95rem;
    }
    .meta .author-link { color:var(--text); text-decoration:none; font-weight:700; }
    .meta .author-link:hover { color:var(--accent); }
    .author-role { color:var(--muted); }
    .dot { color:var(--line); }
    .hero-wrap { margin:0 0 54px; }
    .hero {
      width:100%;
      display:block;
      max-height:680px;
      object-fit:cover;
      border:1px solid var(--line);
      border-radius:22px;
      background:var(--panel);
    }
    .body {
      width:min(760px,100%);
      font-family:Georgia,"Times New Roman",serif;
      font-size:clamp(1.14rem,2vw,1.28rem);
      line-height:1.82;
      color:#edf2ee;
    }
    .body > *:first-child { margin-top:0; }
    .body p { margin:0 0 1.45em; }
    .body h1,.body h2,.body h3,.body h4 {
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--text);
      line-height:1.08;
      letter-spacing:-.03em;
      text-wrap:balance;
    }
    .body h1 { margin:2.7em 0 .72em; font-size:clamp(2.1rem,4.2vw,3.15rem); }
    .body h2 { margin:2.5em 0 .72em; font-size:clamp(1.85rem,3.6vw,2.65rem); }
    .body h3 { margin:2.2em 0 .7em; font-size:clamp(1.5rem,2.8vw,2rem); }
    .body h4 { margin:2em 0 .65em; font-size:clamp(1.25rem,2.2vw,1.55rem); }
    .body strong { color:#fff; }
    .body em { color:#dde6e0; }
    .body hr { border:0; border-top:1px solid var(--line); margin:3.2em 0; }
    .body img { max-width:100%; height:auto; border-radius:16px; border:1px solid var(--line); }
    .body blockquote {
      margin:2em 0;
      padding:.1em 0 .1em 24px;
      border-left:3px solid var(--accent);
      color:#d5ddd8;
      font-size:1.08em;
    }
    .body ul,.body ol { padding-left:1.25em; margin-bottom:1.5em; }
    .body li { margin:.45em 0; }
    .body a { text-underline-offset:3px; }

    .engagement {
      width:min(760px,100%);
      margin-top:54px;
      display:grid;
      gap:16px;
    }
    .engagement-panel {
      padding:22px;
      border:1px solid var(--line);
      border-radius:16px;
      background:linear-gradient(180deg,var(--panel2),var(--panel));
    }
    .engagement-panel h2 { margin:0 0 6px; font-size:1.08rem; }
    .engagement-panel p { margin:0; color:var(--muted); font-size:.9rem; line-height:1.55; }
    .engagement-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:15px; }
    .engagement-action {
      min-height:42px;
      padding:0 14px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border:1px solid #2a3b31;
      border-radius:9px;
      background:#090d0b;
      color:var(--text);
      text-decoration:none;
      font-weight:800;
      cursor:pointer;
    }
    .engagement-action:hover,.engagement-action:focus-visible { border-color:var(--accent); outline:none; }
    .engagement-action[aria-pressed="true"] { color:var(--accent); border-color:var(--accent); background:rgba(56,255,136,.06); }
    .engagement-status { min-height:18px; margin-top:9px; color:var(--accent); font-size:.8rem; }

    .commercial {
      width:min(760px,100%);
      margin:58px 0 0;
      padding:28px;
      border:1px solid #2d4939;
      border-radius:18px;
      background:linear-gradient(145deg,rgba(56,255,136,.08),rgba(11,15,13,.96));
    }
    .commercial h2 { margin:8px 0 10px; font-size:clamp(1.55rem,3vw,2.15rem); line-height:1.05; letter-spacing:-.03em; }
    .commercial p { margin:0; color:var(--soft); line-height:1.6; }
    .commercial .cta {
      display:inline-flex;
      margin-top:20px;
      min-height:46px;
      padding:0 18px;
      align-items:center;
      justify-content:center;
      color:#07110b;
      background:var(--accent);
      text-decoration:none;
      font-weight:900;
      border-radius:8px;
    }
    .disclosure {
      width:min(760px,100%);
      margin:28px 0;
      padding:14px 16px;
      border-left:3px solid var(--accent);
      color:var(--muted);
      background:var(--panel);
      font-size:.88rem;
      line-height:1.55;
    }
    .discovery {
      width:min(760px,100%);
      margin:44px 0 0;
      padding-top:26px;
      border-top:1px solid var(--line);
    }
    .discovery p { margin:0 0 14px; color:var(--muted); font-size:.9rem; }
    .search-profile { display:inline-block; margin-top:12px; font-size:.9rem; }

    .intelligence-map { width:min(900px,100%); margin-top:58px; padding:26px; border:1px solid var(--line); border-radius:16px; background:linear-gradient(145deg,rgba(56,255,136,.04),var(--panel)); }
    .intelligence-map h2 { margin:8px 0 18px; font-size:1.35rem; }
    .graph-row { display:grid; grid-template-columns:135px 1fr; gap:14px; padding:12px 0; border-top:1px solid var(--line); }
    .graph-row:first-of-type { border-top:0; }
    .graph-label { color:var(--muted); font-size:.75rem; font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
    .graph-chips { display:flex; flex-wrap:wrap; gap:7px; }
    .graph-chip { padding:6px 9px; border:1px solid #2a3b31; border-radius:999px; color:#cbd4ce; font-size:.78rem; }
    .next-move { width:min(900px,100%); margin-top:58px; padding-top:32px; border-top:1px solid var(--line); }
    .next-move h2 { margin:8px 0 18px; font-size:clamp(1.55rem,3vw,2.3rem); }
    .next-card { display:grid; grid-template-columns:1fr auto; gap:26px; align-items:end; padding:24px; border:1px solid #31513e; border-radius:14px; background:linear-gradient(145deg,rgba(56,255,136,.075),var(--panel)); color:var(--text); text-decoration:none; }
    .next-card small { color:var(--accent); font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
    .next-card strong { display:block; margin-top:9px; max-width:680px; font-size:1.35rem; line-height:1.12; }
    .next-arrow { color:var(--accent); font-size:1.65rem; }
    .related {
      width:min(900px,100%);
      margin-top:42px;
      padding-top:28px;
      border-top:1px solid var(--line);
    }
    .related h2 { margin:0 0 18px; font-size:1.35rem; }
    .related-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; }
    .related-card {
      display:block;
      padding:18px;
      border:1px solid var(--line);
      border-radius:12px;
      background:var(--panel);
      color:var(--text);
      text-decoration:none;
    }
    .related-card small { color:var(--accent); text-transform:uppercase; letter-spacing:.08em; font-weight:800; }
    .related-card strong { display:block; margin-top:7px; line-height:1.3; }

    .post-end { margin-top:64px; padding-top:30px; border-top:1px solid var(--line); }
    .back { display:inline-block; text-decoration:none; font-weight:800; font-size:.95rem; }
    footer { padding:30px 0 54px; color:var(--muted); border-top:1px solid var(--line); font-size:.88rem; }
    @media (max-width:640px) {
      .shell { width:min(100% - 24px,1120px); }
      article { padding:34px 0 72px; }
      .hero-wrap { margin-bottom:38px; }
      .body { font-size:1.08rem; line-height:1.78; }
      .commercial,.engagement-panel,.intelligence-map { padding:20px; }
      .graph-row { grid-template-columns:1fr; gap:8px; }
      .next-card { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <header><div class="shell"><a class="brand" href="/">GWAP GANG</a></div></header>
  <main class="shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Gwap Gang</a> / <a href="/{{ articleSectionSlug }}/">{{ articleSectionName }}</a> / <span>{{ title }}</span>
    </nav>

    <article data-gwap-article="{{ page.fileSlug }}" data-article-url="{{ page.url }}" data-article-title="{{ title }}">
      <div class="eyebrow">
        <a class="section-link" href="/{{ articleSectionSlug }}/">{{ articleSectionName }}</a>
        <span class="topic-label">// {{ articleCategory }}</span>
      </div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="dek">{{ description }}</p>{% endif %}
      <div class="meta">
        <a class="author-link" href="{{ authorUrl }}">{{ author }}</a>
        {% if authorRole %}<span class="author-role">{{ authorRole }}</span>{% endif %}
        <span class="dot">•</span><span>Published {{ date | readableDate }}</span>
        {% if updated %}<span class="dot">•</span><span>Updated {{ updated | readableDate }}</span>{% endif %}
        <span class="dot">•</span><span>{{ content | readingTime }} min read</span>
      </div>

      {% if image %}
      <div class="hero-wrap">
        <img class="hero" src="{{ image }}" alt="{{ imageAlt or title }}" loading="eager" fetchpriority="high">
      </div>
      {% endif %}

      {% if affiliateDisclosure %}
      <aside class="disclosure" aria-label="Affiliate disclosure">
        {{ affiliateDisclosure }}
      </aside>
      {% endif %}

      <div class="reading-shell"><div class="body" id="article-body">{{ content | safe }}</div></div>

      {% if topics or entities or technologies or businessModels %}
      <section class="intelligence-map" aria-label="Gwap Intelligence Graph connections">
        <div class="eyebrow">Gwap Intelligence Graph</div>
        <h2>What this connects to.</h2>
        {% if topics and topics.length %}<div class="graph-row"><div class="graph-label">Topics</div><div class="graph-chips">{% for item in topics %}<span class="graph-chip">{{ item }}</span>{% endfor %}</div></div>{% endif %}
        {% if entities and entities.length %}<div class="graph-row"><div class="graph-label">Entities</div><div class="graph-chips">{% for item in entities %}<span class="graph-chip">{{ item }}</span>{% endfor %}</div></div>{% endif %}
        {% if technologies and technologies.length %}<div class="graph-row"><div class="graph-label">Technologies</div><div class="graph-chips">{% for item in technologies %}<span class="graph-chip">{{ item }}</span>{% endfor %}</div></div>{% endif %}
        {% if businessModels and businessModels.length %}<div class="graph-row"><div class="graph-label">Business Models</div><div class="graph-chips">{% for item in businessModels %}<span class="graph-chip">{{ item }}</span>{% endfor %}</div></div>{% endif %}
      </section>
      {% endif %}

      <section class="engagement" aria-label="Article feedback and sharing">
        <div class="engagement-panel">
          <h2>Was this useful?</h2>
          <p>Your feedback helps Gwap Intelligence produce more of what is actually worth reading.</p>
          <div class="engagement-actions">
            <button class="engagement-action reaction" type="button" data-reaction="helpful" aria-pressed="false">👍 Yes</button>
            <button class="engagement-action reaction" type="button" data-reaction="not_helpful" aria-pressed="false">👎 Not really</button>
          </div>
          <div class="engagement-status" id="reaction-status" aria-live="polite"></div>
        </div>
        <div class="engagement-panel">
          <h2>Share this intelligence</h2>
          <p>Send the article to somebody who can put it to work.</p>
          <div class="engagement-actions">
            <button class="engagement-action" type="button" id="native-share">Share</button>
            <button class="engagement-action" type="button" id="copy-link">Copy link</button>
            <a class="engagement-action" id="linkedin-share" href="#" target="_blank" rel="noopener">LinkedIn</a>
            <a class="engagement-action" id="x-share" href="#" target="_blank" rel="noopener">X</a>
          </div>
          <div class="engagement-status" id="share-status" aria-live="polite"></div>
        </div>
      </section>

      {% set ctaTarget = ctaUrl or site.primaryOffer.url %}
      {% set ctaHeading = ctaTitle or site.primaryOffer.title %}
      {% set ctaLabel = ctaText or site.primaryOffer.text %}
      {% if ctaTarget %}
      <aside class="commercial" aria-label="Gwap Gang offer">
        <div class="eyebrow">{{ site.primaryOffer.eyebrow }}</div>
        <h2>{{ ctaHeading }}</h2>
        <p>{{ site.primaryOffer.description }}</p>
        <a class="cta" href="{{ ctaTarget }}" data-gwap-event="article_cta_click" data-gwap-placement="post_end">{{ ctaLabel }} →</a>
      </aside>
      {% endif %}

      {% if site.preferredSourcesEnabled or site.googleSearchProfileUrl %}
      <section class="discovery" aria-label="Follow Gwap Gang">
        <p>Want more Gwap Gang intelligence in your search and discovery feeds?</p>
        {% if site.preferredSourcesEnabled %}
        <div google-add-preferred-source-btn data-theme="dark" data-lang="en"></div>
        {% endif %}
        {% if site.googleSearchProfileUrl %}
        <a class="search-profile" href="{{ site.googleSearchProfileUrl }}" rel="me">Follow Gwap Gang on Google →</a>
        {% endif %}
      </section>
      {% endif %}

      {% set nextArticle = collections.posts | graphNextMove(page.url, nextMove, section, articleCategory, topics, entities, technologies, businessModels, relatedArticles) %}
      {% if nextArticle %}
      <section class="next-move" aria-label="Recommended next Gwap Gang article">
        <div class="eyebrow">If you understood this</div>
        <h2>Read this next.</h2>
        <a class="next-card" href="{{ nextArticle.url }}" data-gwap-event="intelligence_graph_next_move">
          <div><small>{{ nextArticle.data.section | sectionName }} // {{ nextArticle.data.category or "Gwap Intelligence" }}</small><strong>{{ nextArticle.data.title }}</strong></div>
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>
      </section>
      {% endif %}

      {% set related = collections.posts | graphRelated(page.url, section, articleCategory, topics, entities, technologies, businessModels, relatedArticles, nextMove, 3) %}
      {% if related.length %}
      <section class="related" aria-label="Connected Gwap Gang intelligence">
        <div class="eyebrow">Connected Intelligence</div>
        <h2>Follow the graph.</h2>
        <div class="related-grid">
          {% for post in related %}
          <a class="related-card" href="{{ post.url }}" data-gwap-event="intelligence_graph_related_click">
            <small>{{ post.data.section | sectionName }} // {{ post.data.category or "Gwap Intelligence" }}</small>
            <strong>{{ post.data.title }}</strong>
          </a>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <div class="post-end"><a class="back" href="/blog/">← Back to All Intelligence</a></div>
    </article>
  </main>
  <footer><div class="shell">© 2026 Gwap Gang. Build. Ship. Get Paid. · <a href="mailto:{{ site.email }}">{{ site.email }}</a></div></footer>

  <script>
  (() => {
    const article = document.querySelector("[data-gwap-article]");
    const articleBody = document.getElementById("article-body");
    const progress = document.getElementById("reading-progress");
    const canonical = document.querySelector('link[rel="canonical"]')?.href || location.href;
    const base = {
      article_slug: {{ page.fileSlug | json | safe }},
      article_title: {{ title | json | safe }},
      article_category: {{ articleCategory | json | safe }},
      article_path: {{ page.url | json | safe }}
    };

    const emit = (event, detail = {}) => {
      const params = { ...base, ...detail };
      window.dispatchEvent(new CustomEvent("gwap:analytics", { detail: { event, ...params } }));
      if (typeof window.gtag === "function") window.gtag("event", event, params);
    };

    emit("article_view");

    const firedDepths = new Set();
    const updateProgress = () => {
      if (!articleBody || !progress) return;
      const rect = articleBody.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + articleBody.offsetHeight - window.innerHeight;
      const percent = end <= start ? 100 : Math.max(0, Math.min(100, ((window.scrollY - start) / (end - start)) * 100));
      progress.style.width = percent + "%";

      [25, 50, 75, 100].forEach((threshold) => {
        if (percent >= threshold && !firedDepths.has(threshold)) {
          firedDepths.add(threshold);
          emit("article_read_depth", { percent_read: threshold });
          if (threshold === 50) emit("article_scroll_50");
          if (threshold === 100) emit("article_completed");
        }
      });
    };

    addEventListener("scroll", updateProgress, { passive: true });
    addEventListener("resize", updateProgress);
    updateProgress();

    const reactionKey = "gwap_reaction:" + base.article_path;
    const reactionButtons = [...document.querySelectorAll(".reaction")];
    const reactionStatus = document.getElementById("reaction-status");
    let savedReaction = null;
    try { savedReaction = localStorage.getItem(reactionKey); } catch (_) {}

    if (savedReaction) {
      reactionButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.reaction === savedReaction));
      });
      if (reactionStatus) reactionStatus.textContent = "Feedback saved. Thank you.";
    }

    reactionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const reaction = button.dataset.reaction;
        reactionButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        try { localStorage.setItem(reactionKey, reaction); } catch (_) {}
        if (reactionStatus) reactionStatus.textContent = "Feedback saved. Thank you.";
        emit("article_feedback", { reaction });
      });
    });

    const shareStatus = document.getElementById("share-status");
    const nativeShare = document.getElementById("native-share");
    const copyLink = document.getElementById("copy-link");
    const linkedinShare = document.getElementById("linkedin-share");
    const xShare = document.getElementById("x-share");

    if (linkedinShare) linkedinShare.href = "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(canonical);
    if (xShare) xShare.href = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(base.article_title) + "&url=" + encodeURIComponent(canonical);

    copyLink?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(canonical);
        if (shareStatus) shareStatus.textContent = "Link copied.";
        emit("article_share", { method: "copy_link" });
      } catch (_) {
        if (shareStatus) shareStatus.textContent = "Copy failed. Use your browser address bar.";
      }
    });

    nativeShare?.addEventListener("click", async () => {
      if (!navigator.share) {
        copyLink?.click();
        return;
      }
      try {
        await navigator.share({ title: base.article_title, url: canonical });
        emit("article_share", { method: "native" });
      } catch (_) {}
    });

    linkedinShare?.addEventListener("click", () => emit("article_share", { method: "linkedin" }));
    xShare?.addEventListener("click", () => emit("article_share", { method: "x" }));

    document.addEventListener("click", (event) => {
      const tracked = event.target.closest("[data-gwap-event]");
      if (tracked) {
        emit(tracked.dataset.gwapEvent, {
          placement: tracked.dataset.gwapPlacement || null,
          destination: tracked.href || null
        });
        return;
      }

      const bodyLink = event.target.closest(".body a");
      if (bodyLink) {
        emit("article_link_click", { destination: bodyLink.href || bodyLink.getAttribute("href") || null });
      }
    });
  })();
  </script>
</body>
</html>
