<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — GWAP Gang</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#050706">
  <link rel="canonical" href="https://gwapgang.com{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="GWAP Intelligence RSS" href="https://gwapgang.com/feed.xml">

  <meta property="og:type" content="article">
  <meta property="og:site_name" content="GWAP Gang">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://gwapgang.com{{ page.url }}">
  {% if image %}<meta property="og:image" content="https://gwapgang.com{{ image }}">{% endif %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {% if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}
  <meta property="article:author" content="{{ author }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  {% if image %}<meta name="twitter:image" content="https://gwapgang.com{{ image }}">{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | json | safe }},
    "description": {{ description | json | safe }},
    "datePublished": {{ date | isoDate | json | safe }},
    "dateModified": {{ (updated or date) | isoDate | json | safe }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://gwapgang.com{{ page.url }}"
    },
    "author": {
      "@type": "Person",
      "name": {{ author | json | safe }},
      "url": "https://gwapgang.com{{ authorUrl }}",
      "jobTitle": {{ authorRole | json | safe }},
      "worksFor": {
        "@type": "Organization",
        "name": "GWAP Gang",
        "url": "https://gwapgang.com/"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "GWAP Gang",
      "url": "https://gwapgang.com/"
    }{% if image %},
    "image": ["https://gwapgang.com{{ image }}"]{% endif %}
  }
  </script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MZF7SR86XK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-MZF7SR86XK', { page_path: '{{ page.url }}' });
  </script>

  <style>
    :root {
      color-scheme: dark;
      --bg:#050706;
      --panel:#0b0f0d;
      --panel-2:#0f1511;
      --text:#f3f7f4;
      --muted:#9aa79f;
      --line:#1d2b23;
      --accent:#38ff88;
      --soft:#d8e0db;
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      margin:0;
      background:var(--bg);
      color:var(--text);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }
    a { color:var(--accent); }
    button { font:inherit; }
    .progress {
      position:fixed;
      inset:0 auto auto 0;
      z-index:100;
      width:0;
      height:3px;
      background:var(--accent);
      box-shadow:0 0 18px rgba(56,255,136,.38);
    }
    .shell { width:min(1120px,calc(100% - 32px)); margin:auto; }
    .reading-shell { width:min(820px,100%); }
    header { padding:24px 0; border-bottom:1px solid var(--line); }
    .brand { color:var(--accent); text-decoration:none; font-weight:900; letter-spacing:.14em; font-size:.82rem; }
    article { padding:72px 0 96px; }
    .eyebrow { color:var(--accent); font-size:.76rem; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }
    article > h1 {
      max-width:980px;
      margin:14px 0 18px;
      font-size:clamp(2.65rem,7vw,5.8rem);
      line-height:.98;
      letter-spacing:-.052em;
      text-wrap:balance;
    }
    .dek {
      max-width:800px;
      margin:0 0 22px;
      color:var(--soft);
      font-size:clamp(1.05rem,2.2vw,1.28rem);
      line-height:1.6;
    }
    .meta {
      display:flex;
      flex-wrap:wrap;
      gap:10px 14px;
      align-items:center;
      color:var(--muted);
      margin-bottom:24px;
      font-size:.95rem;
    }
    .meta strong { color:var(--text); font-weight:700; }
    .meta .author-link { color:var(--text); text-decoration:none; font-weight:700; }
    .meta .author-link:hover { color:var(--accent); }
    .author-role { color:var(--muted); }
    .dot { color:#425047; }
    .tags {
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:0 0 34px;
    }
    .tag {
      display:inline-flex;
      align-items:center;
      min-height:30px;
      padding:0 11px;
      border:1px solid var(--line);
      border-radius:999px;
      color:#bdc9c1;
      background:var(--panel);
      font-size:.76rem;
      font-weight:760;
      letter-spacing:.04em;
    }
    .hero-wrap { margin:0 0 54px; }
    .hero {
      width:100%;
      display:block;
      max-height:680px;
      object-fit:cover;
      border:1px solid var(--line);
      border-radius:22px;
      background:var(--panel);
    }
    .body {
      width:min(760px,100%);
      font-family:Georgia,"Times New Roman",serif;
      font-size:clamp(1.14rem,2vw,1.28rem);
      line-height:1.82;
      color:#edf2ee;
    }
    .body > *:first-child { margin-top:0; }
    .body p { margin:0 0 1.45em; }
    .body h1,.body h2,.body h3,.body h4 {
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--text);
      line-height:1.08;
      letter-spacing:-.03em;
      text-wrap:balance;
    }
    .body h1 { margin:2.7em 0 .72em; font-size:clamp(2.1rem,4.2vw,3.15rem); }
    .body h2 { margin:2.5em 0 .72em; font-size:clamp(1.85rem,3.6vw,2.65rem); }
    .body h3 { margin:2.2em 0 .7em; font-size:clamp(1.5rem,2.8vw,2rem); }
    .body h4 { margin:2em 0 .65em; font-size:clamp(1.25rem,2.2vw,1.55rem); }
    .body strong { color:#fff; }
    .body em { color:#dde6e0; }
    .body hr { border:0; border-top:1px solid var(--line); margin:3.2em 0; }
    .body img { max-width:100%; height:auto; border-radius:16px; border:1px solid var(--line); }
    .body blockquote {
      margin:2em 0;
      padding:.1em 0 .1em 24px;
      border-left:3px solid var(--accent);
      color:#d5ddd8;
      font-size:1.08em;
    }
    .body ul,.body ol { padding-left:1.25em; margin-bottom:1.5em; }
    .body li { margin:.45em 0; }
    .body a { text-underline-offset:3px; }

    .engagement {
      width:min(760px,100%);
      margin-top:58px;
      display:grid;
      gap:18px;
    }
    .panel {
      border:1px solid var(--line);
      background:linear-gradient(180deg,var(--panel-2),var(--panel));
      border-radius:18px;
      padding:22px;
    }
    .panel-title { margin:0 0 6px; font-size:1.05rem; }
    .panel-copy { margin:0; color:var(--muted); font-size:.92rem; line-height:1.55; }
    .reaction-row,.share-row { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
    .action {
      min-height:42px;
      padding:0 14px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:7px;
      border:1px solid #2a3b31;
      border-radius:10px;
      background:#0a0e0c;
      color:var(--text);
      text-decoration:none;
      cursor:pointer;
      font-weight:760;
    }
    .action:hover,.action:focus-visible { border-color:var(--accent); outline:none; }
    .action[aria-pressed="true"] { border-color:var(--accent); color:var(--accent); background:rgba(56,255,136,.06); }
    .reaction-status { min-height:20px; margin-top:10px; color:var(--accent); font-size:.83rem; }

    .related {
      margin-top:64px;
      padding-top:38px;
      border-top:1px solid var(--line);
    }
    .related-head {
      display:flex;
      justify-content:space-between;
      gap:20px;
      align-items:end;
      margin-bottom:18px;
    }
    .related h2 { margin:0; font-size:clamp(1.7rem,3vw,2.35rem); letter-spacing:-.035em; }
    .related-head a { font-size:.9rem; font-weight:760; text-decoration:none; }
    .related-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .related-card {
      display:block;
      padding:18px;
      min-height:150px;
      border:1px solid var(--line);
      border-radius:15px;
      background:var(--panel);
      text-decoration:none;
    }
    .related-card:hover { border-color:#355342; }
    .related-date { color:var(--accent); font-size:.7rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
    .related-title { display:block; margin-top:9px; color:var(--text); font-size:1.03rem; font-weight:800; line-height:1.28; }

    .post-end { margin-top:48px; padding-top:30px; border-top:1px solid var(--line); }
    .back { display:inline-block; text-decoration:none; font-weight:800; font-size:.95rem; }
    footer { padding:30px 0 54px; color:var(--muted); border-top:1px solid var(--line); font-size:.88rem; }

    @media (max-width:800px) {
      .related-grid { grid-template-columns:1fr; }
    }
    @media (max-width:640px) {
      .shell { width:min(100% - 24px,1120px); }
      article { padding:48px 0 72px; }
      .hero-wrap { margin-bottom:38px; }
      .body { font-size:1.08rem; line-height:1.78; }
      .panel { padding:18px; }
    }
  </style>
</head>
<body>
  <div class="progress" id="reading-progress" aria-hidden="true"></div>
  <header><div class="shell"><a class="brand" href="/">GWAP GANG</a></div></header>
  <main class="shell">
    <article id="article" data-article-title="{{ title }}" data-article-url="{{ page.url }}">
      <div class="eyebrow">{{ category or "GWAP Intelligence" }}</div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="dek">{{ description }}</p>{% endif %}
      <div class="meta">
        <a class="author-link" href="{{ authorUrl }}">{{ author }}</a>
        {% if authorRole %}<span class="author-role">{{ authorRole }}</span>{% endif %}
        <span class="dot">•</span><span>Published {{ date | readableDate }}</span>
        {% if updated %}<span class="dot">•</span><span>Updated {{ updated | readableDate }}</span>{% endif %}
        <span class="dot">•</span><span>{{ content | readingTime }} min read</span>
      </div>
      {% if topicTags %}
      <div class="tags" aria-label="Article topics">
        {% for item in topicTags %}<span class="tag">{{ item }}</span>{% endfor %}
      </div>
      {% endif %}
      {% if image %}<div class="hero-wrap"><img class="hero" src="{{ image }}" alt="{{ imageAlt or title }}" fetchpriority="high"></div>{% endif %}
      <div class="reading-shell"><div class="body" id="article-body">{{ content | safe }}</div></div>

      <div class="engagement">
        <section class="panel" aria-labelledby="helpful-title">
          <h2 class="panel-title" id="helpful-title">Was this useful?</h2>
          <p class="panel-copy">Your feedback helps GWAP Intelligence produce more of what is actually worth reading.</p>
          <div class="reaction-row">
            <button class="action reaction" type="button" data-reaction="helpful" aria-pressed="false">👍 Yes</button>
            <button class="action reaction" type="button" data-reaction="not_helpful" aria-pressed="false">👎 Not really</button>
          </div>
          <div class="reaction-status" id="reaction-status" aria-live="polite"></div>
        </section>

        <section class="panel" aria-labelledby="share-title">
          <h2 class="panel-title" id="share-title">Share this intelligence</h2>
          <p class="panel-copy">Send the article to somebody who can put it to work.</p>
          <div class="share-row">
            <button class="action" type="button" id="native-share">Share</button>
            <button class="action" type="button" id="copy-link">Copy link</button>
            <a class="action" id="linkedin-share" href="#" target="_blank" rel="noopener">LinkedIn</a>
            <a class="action" id="x-share" href="#" target="_blank" rel="noopener">X</a>
          </div>
          <div class="reaction-status" id="share-status" aria-live="polite"></div>
        </section>
      </div>

      {% set related = collections.posts | relatedPosts(page.url, 3) %}
      {% if related.length %}
      <section class="related" aria-labelledby="related-title">
        <div class="related-head">
          <div>
            <div class="eyebrow">Keep going</div>
            <h2 id="related-title">Related Intelligence</h2>
          </div>
          <a href="/blog/">View all →</a>
        </div>
        <div class="related-grid">
          {% for post in related %}
          <a class="related-card" href="{{ post.url }}" data-related-link>
            <span class="related-date">{{ post.date | readableDate }}</span>
            <span class="related-title">{{ post.data.title }}</span>
          </a>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <div class="post-end"><a class="back" href="/blog/">← Back to GWAP Blog</a></div>
    </article>
  </main>
  <footer><div class="shell">© 2026 GWAP Gang. Build. Ship. Get Paid.</div></footer>

  <script>
  (() => {
    const article = document.getElementById('article');
    const body = document.getElementById('article-body');
    const progress = document.getElementById('reading-progress');
    const title = article?.dataset.articleTitle || document.title;
    const canonical = document.querySelector('link[rel="canonical"]')?.href || location.href;
    const pagePath = article?.dataset.articleUrl || location.pathname;
    const fired = new Set();

    const track = (eventName, params = {}) => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, {
          article_title: title,
          article_path: pagePath,
          ...params
        });
      }
    };

    track('article_view');

    const updateProgress = () => {
      if (!body || !progress) return;
      const rect = body.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + body.offsetHeight - window.innerHeight;
      const pct = end <= start ? 100 : Math.max(0, Math.min(100, ((window.scrollY - start) / (end - start)) * 100));
      progress.style.width = pct + '%';

      [25, 50, 75, 100].forEach((threshold) => {
        if (pct >= threshold && !fired.has(threshold)) {
          fired.add(threshold);
          track('article_read_depth', { percent_read: threshold });
          if (threshold === 100) track('article_completed');
        }
      });
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();

    const reactionKey = 'gwap_reaction:' + pagePath;
    const buttons = [...document.querySelectorAll('.reaction')];
    const reactionStatus = document.getElementById('reaction-status');
    let savedReaction = null;
    try { savedReaction = localStorage.getItem(reactionKey); } catch (_) {}

    if (savedReaction) {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.reaction === savedReaction));
      });
      if (reactionStatus) reactionStatus.textContent = 'Feedback saved. Thank you.';
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const reaction = button.dataset.reaction;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        try { localStorage.setItem(reactionKey, reaction); } catch (_) {}
        if (reactionStatus) reactionStatus.textContent = 'Feedback saved. Thank you.';
        track('article_feedback', { reaction });
      });
    });

    const shareStatus = document.getElementById('share-status');
    const copy = document.getElementById('copy-link');
    const nativeShare = document.getElementById('native-share');
    const linkedIn = document.getElementById('linkedin-share');
    const xShare = document.getElementById('x-share');

    if (linkedIn) linkedIn.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(canonical);
    if (xShare) xShare.href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(canonical);

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(canonical);
        if (shareStatus) shareStatus.textContent = 'Link copied.';
        track('article_share', { method: 'copy_link' });
      } catch (_) {
        if (shareStatus) shareStatus.textContent = 'Copy failed. Use your browser address bar.';
      }
    });

    nativeShare?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, url: canonical });
          track('article_share', { method: 'native' });
        } catch (_) {}
      } else {
        copy?.click();
      }
    });

    linkedIn?.addEventListener('click', () => track('article_share', { method: 'linkedin' }));
    xShare?.addEventListener('click', () => track('article_share', { method: 'x' }));

    document.querySelectorAll('[data-related-link]').forEach((link) => {
      link.addEventListener('click', () => {
        track('related_article_click', { destination: link.getAttribute('href') || '' });
      });
    });

    document.querySelectorAll('.body a').forEach((link) => {
      link.addEventListener('click', () => {
        track('article_link_click', { destination: link.getAttribute('href') || '' });
      });
    });
  })();
  </script>
</body>
</html>
