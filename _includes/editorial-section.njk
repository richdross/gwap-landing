<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#000000">
<link rel="canonical" href="{{ site.url }}/{{ sectionSlug }}/">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/{{ sectionSlug }}/">
<style>
:root{--acid:#caff00;--paper:#f4f2ec;--muted:#969b93;--line:#30332f;--panel:#070807}
*{box-sizing:border-box}
html{background:#000;scroll-behavior:smooth}
body{margin:0;background:#000;color:var(--paper);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit}
.shell{width:min(1180px,calc(100% - 34px));margin:auto}
.site-head{position:sticky;top:0;z-index:30;background:rgba(0,0,0,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.head-inner{min-height:68px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:30px}
.brand{color:var(--acid);text-decoration:none;font:950 1.12rem/1 Impact,"Arial Black",sans-serif;letter-spacing:.025em;text-transform:uppercase}
.nav{display:flex;justify-content:center;gap:26px}
.nav a{color:#888d85;text-decoration:none;font:800 9px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.11em;text-transform:uppercase;padding:27px 0 25px;border-bottom:1px solid transparent}
.nav a:hover,.nav a[aria-current="page"]{color:var(--paper);border-color:var(--acid)}
.brief-link{color:#d6dad3;text-decoration:none;font:800 9px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.11em;text-transform:uppercase}
.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero:after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 78% 18%,rgba(202,255,0,.08),transparent 24%),linear-gradient(180deg,transparent 65%,rgba(0,0,0,.92))}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:56px;align-items:center;padding:82px 0 76px}
.kicker{color:var(--acid);font:850 10px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase}
h1{margin:16px 0 22px;max-width:790px;font:950 clamp(4rem,9vw,9.2rem)/.79 Impact,"Arial Black",sans-serif;letter-spacing:-.045em;text-transform:uppercase}
.deck{max-width:720px;margin:0;color:#c4c8c1;font:20px/1.58 Georgia,"Times New Roman",serif}
.hero-loop{position:relative;border:1px solid var(--line);background:#020302;box-shadow:0 28px 90px rgba(0,0,0,.48)}
.hero-loop:before{content:"LIVE SIGNAL";position:absolute;z-index:2;left:12px;top:12px;background:#000;color:var(--acid);border:1px solid #373b36;padding:7px 9px;font:850 8px/1 ui-monospace,monospace;letter-spacing:.13em}
.hero-loop video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:#000}
.hero-loop-meta{display:flex;justify-content:space-between;gap:18px;padding:11px 12px;border-top:1px solid var(--line);color:#777c74;font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.11em;text-transform:uppercase}
.manifesto{border-bottom:1px solid var(--line)}
.manifesto-grid{display:grid;grid-template-columns:170px 1fr;gap:42px;padding:48px 0}
.manifesto-num{color:var(--acid);font:850 10px/1.4 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}
.manifesto h2{margin:0;max-width:820px;font:950 clamp(2.5rem,6vw,5.9rem)/.88 Impact,"Arial Black",sans-serif;letter-spacing:-.035em;text-transform:uppercase}
.manifesto p{max-width:760px;margin:18px 0 0;color:#a5aaa2;line-height:1.75}
.content{padding:58px 0 76px}
.editorial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
.signal-card{min-height:260px;background:var(--panel);padding:26px;transition:background .18s ease,transform .18s ease}
.signal-card:hover{background:#0a0d0a;transform:translateY(-2px)}
.signal-card .num{color:var(--acid);font:850 9px/1.4 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}
.signal-card h3{margin:34px 0 12px;font-size:1.42rem;line-height:1.05;text-transform:uppercase}
.signal-card p{margin:0;color:#92978f;line-height:1.65}
.section-rule{display:flex;justify-content:space-between;gap:18px;align-items:end;margin:72px 0 22px;padding-bottom:14px;border-bottom:1px solid var(--line)}
.section-rule h2{margin:0;font:950 clamp(2.4rem,5vw,4.8rem)/.88 Impact,"Arial Black",sans-serif;text-transform:uppercase}
.section-rule span{color:#858a82;font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
.latest{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.post-card{display:block;min-height:240px;padding:22px;border:1px solid var(--line);background:#050605;text-decoration:none}
.post-card:hover{border-color:#596057}
.post-date{color:var(--acid);font:850 8px/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
.post-card h3{margin:32px 0 12px;font-size:1.35rem;line-height:1.08}
.post-card p{margin:0;color:#8f948c;line-height:1.6}
.cta{margin-top:72px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:30px;border:1px solid #41463f;background:linear-gradient(120deg,#080a08,#020302)}
.cta h2{margin:0;font:950 clamp(2.5rem,6vw,5.8rem)/.85 Impact,"Arial Black",sans-serif;text-transform:uppercase}
.cta p{max-width:670px;margin:13px 0 0;color:#9fa49c;line-height:1.65}
.cta a{display:inline-flex;min-height:48px;align-items:center;justify-content:center;background:var(--acid);color:#050505;text-decoration:none;padding:0 19px;font:950 9px/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}
.foot{border-top:1px solid var(--line);padding:24px 0 42px;color:#737871;font:800 8px/1.6 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}
.foot-inner{display:flex;justify-content:space-between;gap:22px}
.foot a{text-decoration:none}.foot a:hover{color:var(--acid)}
@media(max-width:880px){.head-inner{grid-template-columns:1fr auto}.nav{grid-column:1/-1;justify-content:flex-start;overflow-x:auto;gap:20px;border-top:1px solid #171917}.nav a{padding:15px 0}.hero-grid{grid-template-columns:1fr;padding:62px 0 54px}.manifesto-grid{grid-template-columns:1fr}.editorial-grid,.latest{grid-template-columns:1fr}.signal-card{min-height:0}.cta{grid-template-columns:1fr}.foot-inner{display:block}.foot-inner div+div{margin-top:8px}}
</style>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","name":"{{ section }} — Gwap Gang","url":"{{ site.url }}/{{ sectionSlug }}/","description":"{{ description }}","isPartOf":{"@type":"WebSite","name":"Gwap Gang","url":"{{ site.url }}"}}
</script>
</head>
<body>
<header class="site-head">
  <div class="shell head-inner">
    <a class="brand" href="/">GWAP GANG</a>
    <nav class="nav" aria-label="Editorial sections">
      <a href="/culture/" {% if section == "Culture" %}aria-current="page"{% endif %}>Culture</a>
      <a href="/capital/" {% if section == "Capital" %}aria-current="page"{% endif %}>Capital</a>
      <a href="/technology/" {% if section == "Technology" %}aria-current="page"{% endif %}>Technology</a>
      <a href="/intelligence/" {% if section == "Intelligence" %}aria-current="page"{% endif %}>Intelligence</a>
    </nav>
    <a class="brief-link" href="/brief/">The Leverage Brief →</a>
  </div>
</header>

<main>
<section class="hero">
  <div class="shell hero-grid">
    <div>
      <div class="kicker">{{ sectionKicker }}</div>
      <h1>{{ heroTitle | safe }}</h1>
      <p class="deck">{{ heroDeck }}</p>
    </div>
    <div class="hero-loop">
      <video autoplay muted loop playsinline preload="metadata" aria-label="Animated Gwap Gang signal mark">
        <source src="/video/gwap-logo-loop-web.mp4" type="video/mp4">
      </video>
      <div class="hero-loop-meta"><span>{{ section }} // LIVE</span><span>CULTURE × CAPITAL × TECHNOLOGY × INTELLIGENCE</span></div>
    </div>
  </div>
</section>

<section class="manifesto">
  <div class="shell manifesto-grid">
    <div class="manifesto-num">{{ sectionIssue }}</div>
    <div><h2>{{ manifestoTitle }}</h2><p>{{ manifestoText }}</p></div>
  </div>
</section>

<section class="content">
  <div class="shell">
    {{ content | safe }}

    <div class="section-rule"><h2>Latest Intelligence</h2><span>From across Gwap Gang</span></div>
    <div class="latest">
      {% set recentPosts = collections.posts | reverse %}
      {% for post in recentPosts %}
        {% if loop.index <= 3 %}
        <a class="post-card" href="{{ post.url }}">
          <div class="post-date">{{ post.date | readableDate }}</div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
        </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="cta">
      <div><h2>STAY EARLY.</h2><p>The Leverage Brief filters new capability, market movement, useful workflows, and business implications into signal you can actually use.</p></div>
      <a href="/">Join The Signal →</a>
    </div>
  </div>
</section>
</main>

<footer class="foot"><div class="shell foot-inner"><div>Gwap Gang // A more interesting tomorrow.</div><div><a href="/brief/">Leverage Brief</a> · <a href="/blog/">All Articles</a> · <a href="mailto:{{ site.email }}">Contact</a></div></div></footer>
</body>
</html>