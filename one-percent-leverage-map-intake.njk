<title>1% Personal Leverage Map Intake — Gwap Gang</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#000000">
<style>
:root{color-scheme:dark;--bg:#020302;--panel:#080a08;--paper:#f4f2ec;--muted:#9ca29a;--line:#30342f;--acid:#caff00}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--paper);font-family:Arial,Helvetica,sans-serif}.shell{width:min(920px,calc(100% - 32px));margin:auto}.head{border-bottom:1px solid var(--line);background:#000}.head-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between}.brand{color:var(--acid);text-decoration:none;font:950 1.08rem/1 Impact,"Arial Black",sans-serif}.meta{color:#838981;font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}
main{padding:64px 0 90px}.eyebrow{color:var(--acid);font:850 10px/1.4 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}h1{margin:16px 0 18px;font:950 clamp(3.5rem,9vw,7.6rem)/.82 Impact,"Arial Black",sans-serif;text-transform:uppercase;letter-spacing:-.04em}.lead{max-width:720px;color:#b9beb6;line-height:1.65}
form{margin-top:38px}.group{margin-top:34px;padding:24px;border:1px solid var(--line);background:var(--panel)}.group h2{margin:0 0 6px;font-size:1.35rem}.group>p{margin:0 0 20px;color:var(--muted);line-height:1.55}.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{margin-top:17px}.field:first-child{margin-top:0}.field label{display:block;margin-bottom:7px;color:#c9cdc6;font:800 9px/1.4 ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;border:1px solid #444a43;background:#030403;color:#fff;padding:13px 12px;font:15px/1.5 Arial,sans-serif;outline:none;border-radius:0}.field textarea{min-height:120px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--acid)}.hint{display:block;margin-top:6px;color:#777e76;font-size:12px;line-height:1.45}.submit{margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:16px}.submit button{min-height:52px;border:1px solid var(--acid);background:var(--acid);color:#050505;padding:0 20px;font:900 9px/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.submit button:disabled{opacity:.6;cursor:wait}.status{color:#92988f;font:800 9px/1.5 ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}.status.ok{color:var(--acid)}.status.err{color:#f5ff4a}
