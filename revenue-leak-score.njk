<body>
<header class="head"><div class="shell head-inner"><a class="brand" href="/">GWAP GANG</a><nav class="nav"><a href="/intelligence/">Intelligence</a><a href="/capital/">Capital</a><a href="/revenue-rescue-sprint/">Revenue Rescue</a></nav></div></header>
<main>
<section class="hero">
<div class="shell hero-grid">
<div>
<div class="eyebrow">Gwap Gang // Free Growth Diagnostic</div>
<h1>Find What Is Blocking Growth.</h1>
<p class="lead">Tell Gwap what you are trying to improve, then combine that intent with a bounded public-evidence scan. The system qualifies the opportunity and routes you toward the strongest next move without pretending it can see private revenue data.</p>
<div class="trust"><span class="pill">Free</span><span class="pill">No login</span><span class="pill">Public evidence only</span><span class="pill">No fake revenue estimates</span></div>
</div>

<form class="form-card" id="score-form">
<div class="eyebrow">Growth Diagnostic V0.1</div>
<h2>Identify the bottleneck.</h2>
<p>Business intent plus observable evidence helps Gwap distinguish a visibility problem, conversion leak, operational bottleneck, or measurement gap.</p>
<div class="form-grid">
<div class="field full"><label for="businessName">Business name</label><input id="businessName" name="businessName" autocomplete="organization" required maxlength="160" placeholder="Acme Home Services"></div>
<div class="field full"><label for="website">Website</label><input id="website" name="website" type="url" inputmode="url" autocomplete="url" required maxlength="600" placeholder="https://example.com"></div>
<div class="field full"><label for="industry">Industry <span style="color:#727a72">(optional)</span></label><input id="industry" name="industry" maxlength="160" placeholder="HVAC, med spa, legal, B2B services…"></div>
<div class="field full"><label for="email">Business email</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="320" placeholder="owner@example.com"></div>
<div class="field"><label for="primaryGoal">Primary growth goal</label><select id="primaryGoal" name="primaryGoal" required><option value="">Select</option><option value="more_leads">Get more qualified leads</option><option value="better_conversion">Convert more existing demand</option><option value="improve_search_visibility">Improve search visibility</option><option value="automate_operations">Automate operations</option><option value="understand_business">Understand what to fix first</option><option value="reduce_manual_work">Reduce manual work</option><option value="unsure">Not sure yet</option></select></div>
<div class="field"><label for="primaryProblem">Biggest problem right now</label><select id="primaryProblem" name="primaryProblem" required><option value="">Select</option><option value="traffic_visibility">Not enough visibility / traffic</option><option value="conversion_revenue_leak">Traffic or leads are not converting</option><option value="follow_up">Lead follow-up is weak or slow</option><option value="manual_operations">Too much manual work</option><option value="measurement_intelligence">I cannot tell what is working</option><option value="unsure">Not sure yet</option></select></div>
<div class="field full"><label for="urgency">When do you want this problem moving?</label><select id="urgency" name="urgency" required><option value="">Select</option><option value="now">Now / actively solving it</option><option value="30_days">Within 30 days</option><option value="90_days">Within 90 days</option><option value="exploring">Exploring for later</option></select></div>
<div class="field"><label for="role">Your role</label><select id="role" name="role" required><option value="">Select</option><option value="owner">Owner</option><option value="founder">Founder</option><option value="executive">Executive / GM</option><option value="marketing">Marketing</option><option value="sales">Sales</option><option value="agency">Agency / consultant</option><option value="other">Other</option></select></div>
<div class="field"><label for="acquisitionChannel">Main source of new customers</label><select id="acquisitionChannel" name="acquisitionChannel" required><option value="">Select</option><option value="google_ads">Google Ads</option><option value="local_services_ads">Google Local Services Ads</option><option value="meta_ads">Meta / Instagram Ads</option><option value="paid_search">Other paid search</option><option value="lead_marketplace">Lead marketplaces</option><option value="mixed_paid">Several paid channels</option><option value="seo">SEO / organic search</option><option value="organic_social">Organic social</option><option value="referrals">Referrals / repeat business</option><option value="other">Other</option></select></div>
<div class="field"><label for="customerValueBand">Approx. value of one new customer</label><select id="customerValueBand" name="customerValueBand" required><option value="">Select</option><option value="under_250">Under $250</option><option value="250_1000">$250 to $1,000</option><option value="1000_5000">$1,000 to $5,000</option><option value="over_5000">$5,000+</option></select></div>
<div class="field"><label for="monthlyLeadsBand">Approx. inbound leads per month</label><select id="monthlyLeadsBand" name="monthlyLeadsBand" required><option value="">Select</option><option value="under_10">Under 10</option><option value="10_25">10 to 25</option><option value="26_75">26 to 75</option><option value="over_75">75+</option></select></div>
<div class="field full"><div class="eyebrow" style="margin-top:8px">Optional Economics // Unlock an Illustrative Scenario</div></div>
<div class="field"><label for="averageCustomerValue">Average customer value</label><input id="averageCustomerValue" name="averageCustomerValue" type="number" min="1" step="1" inputmode="decimal" placeholder="$2,500"></div>
<div class="field"><label for="monthlyQualifiedLeads">Qualified leads / month</label><input id="monthlyQualifiedLeads" name="monthlyQualifiedLeads" type="number" min="1" step="1" inputmode="numeric" placeholder="40"></div>
<div class="field full"><label for="currentCloseRatePct">Current close rate %</label><input id="currentCloseRatePct" name="currentCloseRatePct" type="number" min=".01" max="100" step=".01" inputmode="decimal" placeholder="20"></div>
<div class="field full hp" aria-hidden="true"><label for="company_website">Company website confirmation</label><input id="company_website" name="company_website" tabindex="-1" autocomplete="off"></div>
<div class="field full"><label class="consent"><input id="followUpConsent" name="followUpConsent" type="checkbox"><span>Email me this diagnostic and allow Gwap to follow up if I explicitly request a review. I can opt out at any time.</span></label></div>
<div class="field full"><label class="consent"><input id="newsletterConsent" name="newsletterConsent" type="checkbox"><span>Also add me to The Leverage Brief for Gwap intelligence and practical growth ideas.</span></label></div>
<div class="field full"><button id="submit" type="submit">Run My Growth Diagnostic →</button><div class="status" id="status" aria-live="polite"></div><div class="micro">The score is a diagnostic risk index. Exact economics are optional and are used only for a transparent sensitivity scenario, never as a claim about revenue you lost.</div></div>
</div>
</form>
</div>
</section>

<section class="section"><div class="shell">
<div class="eyebrow">What The Scanner Checks</div>
<h3 class="section-title">Five places demand can disappear.</h3>
<div class="checks">
<div class="check"><span>01</span><h4>Demand capture</h4><p>Can a high-intent visitor take a clear next step without hunting for it?</p></div>
<div class="check"><span>02</span><h4>Conversion friction</h4><p>Does the buying path ask for too much, create confusion, or send people through generic steps?</p></div>
<div class="check"><span>03</span><h4>Trust architecture</h4><p>Is credible proof visible where a buyer is deciding whether to act?</p></div>
<div class="check"><span>04</span><h4>Follow-up and routing</h4><p>Do different intents appear to have a sensible path into the business?</p></div>
<div class="check"><span>05</span><h4>Measurement readiness</h4><p>Can the business tell which traffic and conversion work is actually paying off?</p></div>
</div>
</div></section>

<section id="result" class="result-shell">
<div class="shell">
<div class="eyebrow">Your Growth Diagnostic</div>
<div class="result-head">
<div class="score-box"><div class="score-number" id="score-number">0</div><div class="score-denom">OUT OF 100 // PUBLIC-EVIDENCE RISK INDEX</div><div class="band" id="score-band"></div></div>
<div>
<div class="eyebrow">Commercial Intelligence Result</div>
<h3 class="preview-title">Evidence first. Then the right route.</h3>
<div class="context-box" id="business-context"></div>
<div class="context-box" id="route-box" style="display:none"></div>
<div class="preview-grid" id="preview-grid"></div>
<div class="scenario-box" id="scenario-box" style="display:none"></div>
<div class="flags" id="flags"></div>
<div class="disclaimer" id="disclaimer"></div>
<div class="next-action" id="next-action"></div>
</div>
</div>
</div>
</section>
</main>
<footer class="foot"><div class="shell">Gwap Gang // Intelligence should end in action.</div></footer>

<script>
(() => {
  const endpoint = {{ site.revenueLeakScore.endpoint | json | safe }};
  const eventEndpoint = endpoint + "/event";
  const checkoutUrl = {{ site.revenueRescueSprint.checkoutUrl | json | safe }};
  const form = document.getElementById("score-form");
  const submit = document.getElementById("submit");
  const status = document.getElementById("status");
  const result = document.getElementById("result");

  function esc(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  function titleFromType(value) {
    return String(value || "verified finding").replace(/_/g," ").replace(/\b\w/g, c => c.toUpperCase());
  }

  async function trackEvent(leadId, eventType, metadata = {}) {
    if (!leadId || !eventType) return false;
    try {
      const response = await fetch(eventEndpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ lead_id: leadId, event_type: eventType, metadata })
      });
      return response.ok;
    } catch {
      return false;
    }
  }

  function money(value) {
    return "$" + Number(value || 0).toLocaleString("en-US", { maximumFractionDigits: 0 });
  }

  function renderAction(data, card) {
    const container = document.getElementById("next-action");
    const action = card.nextAction || {};
    const primary = action.primary || {};
    const secondary = action.secondary || null;
    container.innerHTML = `<div class="eyebrow">Recommended Next Action</div><h3>${esc(action.headline || "Use the evidence before making the next move.")}</h3><div class="action-row" id="action-row"></div><div class="status" id="action-status"></div>`;
    const row = document.getElementById("action-row");
    const actionStatus = document.getElementById("action-status");

    function actionButton(item, secondaryStyle = false) {
      if (!item || !item.kind) return null;
      const el = document.createElement(item.url ? "a" : "button");
      el.className = secondaryStyle ? "cta secondary" : "cta";
      el.textContent = item.label || "Continue";
      if (item.url) el.href = item.kind === "checkout" && checkoutUrl ? checkoutUrl : item.url;

      el.addEventListener("click", async (event) => {
        const eventType = item.event || (
          item.kind === "case_example" ? "case_example_clicked" :
          item.kind === "rescue_plan" ? "rescue_plan_clicked" :
          item.kind === "checkout" ? "checkout_clicked" :
          null
        );

        if (!item.url) {
          event.preventDefault();
          el.disabled = true;
          const ok = await trackEvent(data.lead_id, eventType, { conversion_path: action.key || null });
          if (item.kind === "priority_review" || item.kind === "founder_review") {
            actionStatus.textContent = ok
              ? "Review request recorded. Gwap will follow up using the business email you provided."
              : "A review request requires email follow-up consent. Enable it and rerun the diagnostic.";
          } else if (item.kind === "newsletter_opt_in") {
            actionStatus.textContent = ok
              ? "You're subscribed to The Leverage Brief."
              : "Newsletter signup is temporarily unavailable.";
          }
          el.disabled = false;
          return;
        }

        event.preventDefault();
        await trackEvent(data.lead_id, eventType, { conversion_path: action.key || null });
        window.location.href = el.href;
      });
      return el;
    }

    if (primary.kind === "newsletter_opt_in" && data.newsletter_synced) {
      const note = document.createElement("div");
      note.className = "pill";
      note.textContent = "The Leverage Brief is already on";
      row.appendChild(note);
    } else {
      const primaryEl = actionButton(primary, false);
      if (primaryEl) row.appendChild(primaryEl);
    }
    const secondaryEl = actionButton(secondary, true);
    if (secondaryEl) row.appendChild(secondaryEl);
  }

  function render(data) {
    const card = data.scorecard || {};
    document.getElementById("score-number").textContent = String(data.leak_score ?? 0);
    document.getElementById("score-band").textContent = String(data.leak_risk_band || "unknown") + " leak risk";
    document.getElementById("business-context").textContent = card.businessContext || "";

    const diagnostic = data.growth_diagnostic || card.growthDiagnostic || null;
    const routeBox = document.getElementById("route-box");
    if (diagnostic?.route) {
      routeBox.style.display = "block";
      routeBox.innerHTML = `<div class="eyebrow">Best-Fit Route // ${esc(diagnostic.route.confidence || "directional")} confidence</div><h3 style="margin:10px 0 8px">${esc(diagnostic.route.offerName || "Gwap Review")}</h3><div style="color:#aeb4ac;line-height:1.6">${esc(diagnostic.route.reason || "")}</div>`;
    } else {
      routeBox.style.display = "none";
      routeBox.innerHTML = "";
    }

    const preview = Array.isArray(card.revenueRescuePreview) ? card.revenueRescuePreview : [];
    document.getElementById("preview-grid").innerHTML = preview.length
      ? preview.slice(0, 3).map(item => `
        <article class="preview-card">
          <div class="rank">#${esc(item.rank)} // ${esc(item.title)}</div>
          <h4>${esc(item.title)}</h4>
          <p><strong>Observed evidence:</strong> ${esc(item.evidence)}</p>
          <p><strong>Likely business consequence:</strong> ${esc(item.likelyBusinessConsequence)}</p>
          <p><strong>First repair to test:</strong> ${esc(item.recommendedFix)}</p>
          <p><strong>What Gwap would investigate next:</strong> ${esc(item.investigateNext)}</p>
        </article>`).join("")
      : '<article class="preview-card"><div class="rank">BOUNDARY</div><h4>No three-leak story was forced.</h4><p>The public scan did not return enough evidence to justify three high-confidence findings.</p></article>';

    const scenario = card.scenario;
    const scenarioBox = document.getElementById("scenario-box");
    if (scenario) {
      scenarioBox.style.display = "block";
      scenarioBox.innerHTML = `<div class="eyebrow">Illustrative Sensitivity Scenario</div><div class="scenario-range">${money(scenario.monthlyValueLowUsd)} – ${money(scenario.monthlyValueHighUsd)} / month</div><div style="color:#969d95;line-height:1.55">${esc(scenario.explanation)}</div>`;
    } else {
      scenarioBox.style.display = "none";
      scenarioBox.innerHTML = "";
    }

    document.getElementById("disclaimer").textContent = card.disclaimer || "";

    const flags = Array.isArray(card.flags) ? card.flags : [];
    document.getElementById("flags").innerHTML = flags.length
      ? flags.map(flag => `<div class="flag"><div class="flag-label">${esc(flag.label)}</div><div class="meter"><i style="width:${Math.max(0,Math.min(100,Number(flag.risk)||0))}%"></i></div><small>${esc(flag.band)} risk · ${esc(flag.risk)}/100</small></div>`).join("")
      : '<div class="flag"><div class="flag-label">Secondary flags</div><p style="color:#8f968e;margin:14px 0 0">No strong secondary public-evidence flag was found.</p></div>';

    renderAction(data, card);
    result.style.display = "block";
    result.scrollIntoView({ behavior: "smooth", block: "start" });
    trackEvent(data.lead_id, "result_viewed", {
      leak_score: data.leak_score,
      offer_key: diagnostic?.route?.offerKey || "revenue_rescue_sprint"
    });
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    submit.disabled = true;
    submit.textContent = "Diagnosing…";
    status.className = "status";
    status.textContent = "Combining your stated growth objective with reachable public evidence…";

    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    payload.followUpConsent = document.getElementById("followUpConsent").checked;
    payload.newsletterConsent = document.getElementById("newsletterConsent").checked;
    const params = new URLSearchParams(window.location.search);
    payload.utmSource = params.get("utm_source") || "";
    payload.utmMedium = params.get("utm_medium") || "";
    payload.utmCampaign = params.get("utm_campaign") || "";
    payload.utmContent = params.get("utm_content") || "";
    payload.utmTerm = params.get("utm_term") || "";
    payload.referrer = document.referrer || "";
    payload.landingPath = window.location.pathname + window.location.search;

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload)
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok || !body.ok) throw new Error(body.error || "Score request failed");
      render(body);
      status.textContent = body.email_sent
        ? "Score complete. A copy was also sent to your email."
        : "Score complete.";
    } catch (error) {
      status.className = "status error";
      status.textContent = error?.message || "We could not complete the scan. Check the URL and try again.";
    } finally {
      submit.disabled = false;
      submit.textContent = "Run My Growth Diagnostic →";
    }
  });
})();
</script>
</body>
</html>
