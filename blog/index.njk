---
permalink: /blog/index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>All Intelligence — Gwap Gang</title>
  <meta name="description" content="Explore all Gwap Gang editorial intelligence across Culture, Capital, Technology, and Intelligence.">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ site.url }}/blog/">
  <link rel="alternate" type="application/rss+xml" title="Gwap Intelligence RSS" href="{{ site.url }}{{ site.rssPath }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Gwap Gang">
  <meta property="og:title" content="All Intelligence — Gwap Gang">
  <meta property="og:description" content="Culture × capital × technology × intelligence. Browse every Gwap Gang article in one discovery hub.">
  <meta property="og:url" content="{{ site.url }}/blog/">

  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"CollectionPage",
    "name":"All Intelligence — Gwap Gang",
    "url":"{{ site.url }}/blog/",
    "description":"Explore all Gwap Gang editorial intelligence across Culture, Capital, Technology, and Intelligence.",
    "isPartOf":{"@type":"WebSite","name":"Gwap Gang","url":"{{ site.url }}/"}
  }
  </script>

  <style>
    :root{
      color-scheme:dark;
      --bg:#020302;
      --panel:#070907;
      --panel2:#0a0d0a;
      --paper:#f4f2ec;
      --muted:#969b93;
      --line:#30332f;
      --acid:#caff00;
    }
    *{box-sizing:border-box}
    html{background:#000;scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--paper);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    button{font:inherit}
    .shell{width:min(1180px,calc(100% - 34px));margin:auto}

    .site-head{position:sticky;top:0;z-index:30;background:rgba(0,0,0,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .head-inner{min-height:68px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:30px}
    .brand{color:var(--acid);text-decoration:none;font:950 1.12rem/1 Impact,"Arial Black",sans-serif;letter-spacing:.025em;text-transform:uppercase}
    .nav{display:flex;justify-content:center;gap:26px}
    .nav a{color:#888d85;text-decoration:none;font:800 9px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.11em;text-transform:uppercase;padding:27px 0 25px;border-bottom:1px solid transparent}
    .nav a:hover{color:var(--paper);border-color:var(--acid)}
    .brief-link{color:#d6dad3;text-decoration:none;font:800 9px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.11em;text-transform:uppercase}

    .hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
    .hero:after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 80% 10%,rgba(202,255,0,.075),transparent 28%),linear-gradient(180deg,transparent 60%,rgba(0,0,0,.8))}
    .hero-inner{position:relative;z-index:2;padding:82px 0 66px}
    .eyebrow{color:var(--acid);font:850 10px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase}
    h1{max-width:980px;margin:18px 0 24px;font:950 clamp(4.4rem,10vw,10rem)/.78 Impact,"Arial Black",sans-serif;letter-spacing:-.045em;text-transform:uppercase}
    .intro{max-width:760px;margin:0;color:#b9beb6;font:20px/1.65 Georgia,"Times New Roman",serif}
    .signal-line{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:30px;color:#747a72;font:800 8px/1.5 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
    .signal-line strong{color:var(--acid)}

    .section-strip{border-bottom:1px solid var(--line);background:#040504}
    .section-grid{display:grid;grid-template-columns:repeat(4,1fr)}
    .section-link{position:relative;min-height:126px;padding:22px;border-left:1px solid var(--line);text-decoration:none;background:#050605;transition:background .18s ease,transform .18s ease}
    .section-link:last-child{border-right:1px solid var(--line)}
    .section-link:hover{background:#0a0d0a;transform:translateY(-2px)}
    .section-link small{display:block;color:var(--acid);font:850 8px/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
    .section-link strong{display:block;margin-top:24px;font-size:1.25rem;text-transform:uppercase}
    .section-link span{display:block;margin-top:7px;color:#858a82;font-size:.86rem;line-height:1.45}

    .discovery{padding:54px 0 88px}
    .toolbar{display:flex;justify-content:space-between;align-items:end;gap:24px;padding-bottom:18px;border-bottom:1px solid var(--line)}
    .toolbar h2{margin:0;font:950 clamp(2.8rem,6vw,5.8rem)/.86 Impact,"Arial Black",sans-serif;letter-spacing:-.035em;text-transform:uppercase}
    .count{color:#858a82;font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
    .filters{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 30px}
    .filter{border:1px solid #3a3e39;background:#070807;color:#a4a9a1;padding:10px 13px;cursor:pointer;font:850 8px/1 ui-monospace,monospace;letter-spacing:.11em;text-transform:uppercase}
    .filter:hover,.filter[aria-pressed="true"]{border-color:var(--acid);background:var(--acid);color:#050505}

    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .card{display:flex;min-width:0;flex-direction:column;border:1px solid var(--line);background:var(--panel);text-decoration:none;transition:border-color .18s ease,background .18s ease,transform .18s ease}
    .card:hover{border-color:#596057;background:var(--panel2);transform:translateY(-3px)}
    .card[hidden]{display:none}
    .image-wrap{overflow:hidden;border-bottom:1px solid var(--line);background:#030403}
    .card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .28s ease}
    .card:hover img{transform:scale(1.018)}
    .card-body{display:flex;flex:1;flex-direction:column;padding:22px}
    .card-meta{display:flex;flex-wrap:wrap;gap:7px 10px;color:#7d837b;font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.11em;text-transform:uppercase}
    .section-name{color:var(--acid)}
    .card h3{margin:30px 0 12px;font-size:1.5rem;line-height:1.06;letter-spacing:-.02em}
    .desc{margin:0;color:#969b93;line-height:1.62}
    .read{margin-top:auto;padding-top:26px;color:#cdd1ca;font:850 8px/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}
    .empty{border:1px dashed var(--line);padding:34px;color:var(--muted)}
    .no-results{display:none;margin-top:20px;border:1px dashed var(--line);padding:28px;color:var(--muted)}
    .no-results.show{display:block}

    .foot{border-top:1px solid var(--line);padding:24px 0 42px;color:#737871;font:800 8px/1.6 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}
    .foot-inner{display:flex;justify-content:space-between;gap:22px}
    .foot a{text-decoration:none}.foot a:hover{color:var(--acid)}

    @media(max-width:900px){
      .head-inner{grid-template-columns:1fr auto}
      .nav{grid-column:1/-1;justify-content:flex-start;overflow-x:auto;gap:20px;border-top:1px solid #171917}
      .nav a{padding:15px 0}
      .section-grid{grid-template-columns:repeat(2,1fr)}
      .section-link:nth-child(2){border-right:1px solid var(--line)}
      .grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:620px){
      .hero-inner{padding:58px 0 48px}
      .section-grid,.grid{grid-template-columns:1fr}
      .section-link,.section-link:nth-child(2){border-right:1px solid var(--line)}
      .toolbar{display:block}
      .count{margin-top:12px}
    }
  </style>
</head>
<body>
<header class="site-head">
  <div class="shell head-inner">
    <a class="brand" href="/">GWAP GANG</a>
    <nav class="nav" aria-label="Primary editorial sections">
      <a href="/culture/">Culture</a>
      <a href="/capital/">Capital</a>
      <a href="/technology/">Technology</a>
      <a href="/intelligence/">Intelligence</a>
    </nav>
    <a class="brief-link" href="/brief/">The Leverage Brief →</a>
  </div>
</header>

<main>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="eyebrow">Gwap Gang // Discovery Hub</div>
      <h1>All<br>Intelligence.</h1>
      <p class="intro">One archive for every Gwap Gang article—organized across Culture, Capital, Technology, and Intelligence so you can follow the signal without digging through a generic blog.</p>
      <div class="signal-line">
        <span><strong>01</strong> Culture</span>
        <span><strong>02</strong> Capital</span>
        <span><strong>03</strong> Technology</span>
        <span><strong>04</strong> Intelligence</span>
      </div>
    </div>
  </section>

  <section class="section-strip" aria-label="Explore permanent editorial sections">
    <div class="shell section-grid">
      <a class="section-link" href="/culture/"><small>01 // Culture</small><strong>Behavior moves first.</strong><span>Media, taste, creators, identity, attention.</span></a>
      <a class="section-link" href="/capital/"><small>02 // Capital</small><strong>Follow the economics.</strong><span>Revenue, ownership, margins, leverage.</span></a>
      <a class="section-link" href="/technology/"><small>03 // Technology</small><strong>Track capability.</strong><span>AI, agents, automation, infrastructure.</span></a>
      <a class="section-link" href="/intelligence/"><small>04 // Intelligence</small><strong>Connect the dots.</strong><span>Evidence, opportunity, analysis, action.</span></a>
    </div>
  </section>

  <section class="discovery">
    <div class="shell">
      <div class="toolbar">
        <h2>Browse The Archive</h2>
        <div class="count" id="result-count" aria-live="polite">Loading intelligence…</div>
      </div>

      <div class="filters" role="group" aria-label="Filter articles by editorial section">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="filter" type="button" data-filter="culture" aria-pressed="false">Culture</button>
        <button class="filter" type="button" data-filter="capital" aria-pressed="false">Capital</button>
        <button class="filter" type="button" data-filter="technology" aria-pressed="false">Technology</button>
        <button class="filter" type="button" data-filter="intelligence" aria-pressed="false">Intelligence</button>
      </div>

      {% if collections.posts %}
      <div class="grid" id="intelligence-grid">
        {% for post in collections.posts | reverse %}
        {% set postSection = post.data.section or "intelligence" %}
        {% if postSection == "culture" %}
          {% set postSectionName = "Culture" %}
        {% elif postSection == "capital" %}
          {% set postSectionName = "Capital" %}
        {% elif postSection == "technology" %}
          {% set postSectionName = "Technology" %}
        {% else %}
          {% set postSection = "intelligence" %}
          {% set postSectionName = "Intelligence" %}
        {% endif %}
        <a class="card" href="{{ post.url }}" data-section="{{ postSection }}">
          {% if post.data.image %}
          <div class="image-wrap"><img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy"></div>
          {% endif %}
          <div class="card-body">
            <div class="card-meta">
              <span class="section-name">{{ postSectionName }}</span>
              <span>// {{ post.data.category or "Gwap Intelligence" }}</span>
              <span>// {{ post.date | readableDate }}</span>
            </div>
            <h3>{{ post.data.title }}</h3>
            <p class="desc">{{ post.data.description }}</p>
            <div class="read">Read Intelligence →</div>
          </div>
        </a>
        {% endfor %}
      </div>
      <div class="no-results" id="no-results">No published intelligence is assigned to this section yet.</div>
      {% else %}
      <div class="empty">No intelligence has been published yet.</div>
      {% endif %}
    </div>
  </section>
</main>

<footer class="foot">
  <div class="shell foot-inner">
    <div>Gwap Gang // A more interesting tomorrow.</div>
    <div><a href="/graph/">Explore Graph</a> · <a href="/brief/">Leverage Brief</a> · <a href="/blog/">All Intelligence</a> · <a href="mailto:{{ site.email }}">Contact</a></div>
  </div>
</footer>

<script>
(()=>{
  const buttons=[...document.querySelectorAll('[data-filter]')];
  const cards=[...document.querySelectorAll('[data-section]')];
  const count=document.getElementById('result-count');
  const empty=document.getElementById('no-results');
  const valid=new Set(['all','culture','capital','technology','intelligence']);

  function labelFor(filter){
    if(filter==='all') return 'All Intelligence';
    return filter.charAt(0).toUpperCase()+filter.slice(1);
  }

  function apply(filter,updateHash=true){
    if(!valid.has(filter)) filter='all';

    buttons.forEach(button=>{
      button.setAttribute('aria-pressed',String(button.dataset.filter===filter));
    });

    let visible=0;
    cards.forEach(card=>{
      const show=filter==='all'||card.dataset.section===filter;
      card.hidden=!show;
      if(show) visible++;
    });

    if(count) count.textContent=visible+' article'+(visible===1?'':'s')+' // '+labelFor(filter);
    if(empty) empty.classList.toggle('show',visible===0);

    if(updateHash){
      const next=filter==='all'?'':('#'+filter);
      history.replaceState(null,'',location.pathname+location.search+next);
    }
  }

  buttons.forEach(button=>button.addEventListener('click',()=>apply(button.dataset.filter)));
  const initial=location.hash.slice(1).toLowerCase();
  apply(valid.has(initial)?initial:'all',false);
})();
</script>
</body>
</html>
