---
permalink: /blog/index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GWAP Blog — GWAP Gang</title>
  <meta name="description" content="Build logs, money systems, AI field notes and founder lessons from GWAP Gang.">
  <link rel="canonical" href="https://gwapgang.com/blog/">
  <style>
    :root { color-scheme:dark; --bg:#050706; --panel:#0b0f0d; --text:#f3f7f4; --muted:#9aa79f; --line:#1d2b23; --accent:#38ff88; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font:16px/1.6 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:inherit; }
    .shell { width:min(1100px,calc(100% - 32px)); margin:auto; }
    header { padding:28px 0; border-bottom:1px solid var(--line); }
    .brand { color:var(--accent); text-decoration:none; font-weight:900; letter-spacing:.12em; }
    .hero { padding:72px 0 44px; }
    .eyebrow { color:var(--accent); font-size:.78rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
    h1 { margin:10px 0; font-size:clamp(2.5rem,8vw,5.5rem); line-height:1; letter-spacing:-.05em; }
    .intro { max-width:680px; color:var(--muted); font-size:1.1rem; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; padding:18px 0 80px; }
    .card { display:block; border:1px solid var(--line); border-radius:16px; overflow:hidden; text-decoration:none; background:var(--panel); }
    .card img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
    .card-body { padding:20px; }
    .date { color:var(--accent); font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
    .card h2 { margin:8px 0 6px; font-size:1.35rem; line-height:1.2; }
    .desc { color:var(--muted); }
    .empty { border:1px dashed var(--line); border-radius:16px; padding:32px; color:var(--muted); }
  </style>
</head>
<body>
  <header><div class="shell"><a class="brand" href="/">GWAP GANG</a></div></header>
  <main class="shell">
    <section class="hero">
      <div class="eyebrow">GWAP Intelligence</div>
      <h1>The Blog</h1>
      <p class="intro">Build logs, money systems, AI field notes and founder lessons from inside the GWAP lab.</p>
    </section>
    {% if collections.posts %}
    <section class="grid">
      {% for post in collections.posts | reverse %}
      <a class="card" href="{{ post.url }}">
        {% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}">{% endif %}
        <div class="card-body">
          <div class="date">{{ post.date | readableDate }}</div>
          <h2>{{ post.data.title }}</h2>
          <div class="desc">{{ post.data.description }}</div>
        </div>
      </a>
      {% endfor %}
    </section>
    {% else %}
      <div class="empty">No articles published yet. The first Pages CMS article will appear here automatically.</div>
    {% endif %}
  </main>
</body>
</html>
