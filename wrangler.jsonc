{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gwapgang-core",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
