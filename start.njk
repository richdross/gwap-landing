<style>
:root{
  color-scheme:dark;
  --bg:#020302;
  --panel:#070907;
  --panel-2:#0b0e0b;
  --paper:#f3f1eb;
  --muted:#969c94;
  --soft:#c6cac3;
  --line:#2b302b;
  --line-strong:#3c433b;
  --acid:#caff00;
}
*{box-sizing:border-box}
html{background:#000;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--paper);font-family:Arial,Helvetica,sans-serif;font-size:18px;-webkit-font-smoothing:antialiased}
a{color:inherit}
.shell{width:min(1360px,calc(100% - 48px));margin:auto}
.head{position:relative;z-index:5;border-bottom:1px solid var(--line);background:rgba(0,0,0,.94)}
.head-inner{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.brand{color:var(--acid);text-decoration:none;font:950 1.3rem/1 Impact,"Arial Black",sans-serif;letter-spacing:.01em}
.nav{display:flex;gap:28px;align-items:center}
.nav a{color:#b2b8b0;text-decoration:none;font:850 12px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}
.nav a:hover,.nav a:focus-visible{color:var(--paper)}
.hero{
  padding:118px 0 88px;
  border-bottom:1px solid var(--line);
  background:
    radial-gradient(circle at 78% 18%,rgba(202,255,0,.085),transparent 27%),
    radial-gradient(circle at 12% 76%,rgba(202,255,0,.035),transparent 22%),
    #020302;
}
.eyebrow{color:var(--acid);font:850 12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;text-transform:uppercase}
.hero h1{
  max-width:1180px;
  margin:20px 0 28px;
  font:950 clamp(5rem,10.4vw,10.6rem)/.79 Impact,"Arial Black",sans-serif;
  letter-spacing:-.047em;
  text-transform:uppercase;
}
.hero-copy{max-width:930px;color:#d0d4ce;font:24px/1.62 Georgia,serif}
.hero-rule{display:flex;flex-wrap:wrap;gap:14px 28px;margin-top:36px;color:#9ea69d;font:800 11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}
.hero-rule span::before{content:"//";color:var(--acid);margin-right:8px}

.section{padding:86px 0;border-bottom:1px solid var(--line)}
.section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:end;margin-bottom:42px}
.section h2{margin:10px 0 0;font:950 clamp(3.5rem,6.8vw,6.9rem)/.83 Impact,"Arial Black",sans-serif;letter-spacing:-.04em;text-transform:uppercase}
.section-intro{max-width:760px;margin:0;color:#b8beb6;font-size:20px;line-height:1.7}

.routes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.route{
  position:relative;
  display:flex;
  min-height:430px;
  flex-direction:column;
  padding:34px;
  border:1px solid var(--line);
  background:linear-gradient(180deg,#090b09,#060706);
  text-decoration:none;
  transition:transform .16s ease,border-color .16s ease,background .16s ease;
}
.route:hover,.route:focus-visible{transform:translateY(-3px);border-color:#6c7767;background:#0a0d0a;outline:none}
.route.primary{border-color:#526041;background:linear-gradient(180deg,rgba(202,255,0,.055),#070907 34%)}
.route-number{display:flex;justify-content:space-between;gap:18px;color:var(--acid);font:850 11px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em;text-transform:uppercase}
.route-number .price{color:#8d958a}
.route h3{margin:56px 0 18px;font:950 clamp(2.55rem,3vw,3.35rem)/.94 Impact,"Arial Black",sans-serif;letter-spacing:-.022em;text-transform:uppercase}
.route p{margin:0;color:#bbc1ba;font-size:19px;line-height:1.66}
.route .best-for{margin-top:26px;padding-top:21px;border-top:1px solid var(--line);color:#d4d8d2;font-size:17px;line-height:1.62}
.route .best-for strong{display:block;margin-bottom:8px;color:#9da59c;font:850 11px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}
.route-cta{margin-top:auto;padding-top:38px;color:var(--acid);font:900 14px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}

.secondary-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:20px}
.secondary-card{padding:36px;border:1px solid var(--line);background:var(--panel);min-height:300px}
.secondary-card h3{margin:28px 0 14px;font-size:2.2rem;line-height:1.08}
.secondary-card p{margin:0;color:#bbc1ba;font-size:19px;line-height:1.66}
.link-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.ghost,.acid-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:58px;
  padding:0 24px;
  border:1px solid var(--line-strong);
  text-decoration:none;
  font:900 13px/1 ui-monospace,SFMono-Regular,Menlo,monospace;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.ghost{color:#c4c9c2;background:#070807}
.ghost:hover,.ghost:focus-visible{border-color:#737d70}
.acid-btn{border-color:var(--acid);background:var(--acid);color:#050505}
.coming{display:inline-flex;margin-top:24px;padding:11px 13px;border:1px solid #44503e;color:var(--acid);font:850 11px/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}

.process{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line)}
.step{position:relative;padding:30px;min-height:220px;border-right:1px solid var(--line);background:#060706}
.step:last-child{border-right:0}
.step small{color:var(--acid);font:850 11px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em;text-transform:uppercase}
.step h3{margin:46px 0 12px;font-size:1.55rem;line-height:1.08;text-transform:uppercase}
.step p{margin:0;color:#b6bdb4;font-size:17px;line-height:1.6}
.step:not(:last-child)::after{content:"→";position:absolute;right:-9px;top:50%;z-index:2;color:var(--acid);background:var(--bg);padding:3px}

.boundary{padding:40px;border:1px solid var(--line);background:linear-gradient(90deg,rgba(202,255,0,.035),transparent 38%),#050605}
.boundary-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:52px;align-items:start}
.boundary h3{margin:14px 0 0;font:950 clamp(2.6rem,4.6vw,4.8rem)/.88 Impact,"Arial Black",sans-serif;text-transform:uppercase}
.boundary p{margin:0;color:#bec4bd;font-size:19px;line-height:1.7}
.boundary p+p{margin-top:12px}

.final{padding:102px 0 112px;text-align:center}
.final h2{max-width:1080px;margin:14px auto 22px;font:950 clamp(3.8rem,7.5vw,7.4rem)/.83 Impact,"Arial Black",sans-serif;letter-spacing:-.04em;text-transform:uppercase}
.final p{max-width:820px;margin:0 auto 36px;color:#bec4bd;font-size:19px;line-height:1.68}
.foot{border-top:1px solid var(--line);padding:32px 0 50px;color:#989f97;font:800 11px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}
.foot-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.foot a{text-decoration:none;color:#929990}

@media(max-width:900px){
  .routes{grid-template-columns:1fr}
  .route{min-height:340px}
  .secondary-grid,.section-head,.boundary-grid{grid-template-columns:1fr}
  .process{grid-template-columns:1fr 1fr}
  .step:nth-child(2){border-right:0}
  .step:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .step:nth-child(2)::after{display:none}
}
@media(max-width:620px){
  .nav{display:none}
  .shell{width:min(100% - 28px,1360px)}
  .hero{padding:72px 0 60px}
  .hero h1{font-size:clamp(3.8rem,18vw,5.6rem);line-height:.81}
  .hero-copy{font-size:19px;line-height:1.64}
  .hero-rule{font-size:11px;gap:10px 17px;margin-top:30px}
  .section{padding:60px 0}
  .section-intro{font-size:18px}
  .route{padding:28px;min-height:0}
  .route h3{font-size:2.3rem;margin-top:40px}
  .route p{font-size:17px}
  .route .best-for{font-size:15.5px}
  .route-cta{font-size:13px;padding-top:30px}
  .secondary-card{padding:28px}
  .secondary-card p{font-size:17px}
  .ghost,.acid-btn{min-height:58px;padding:0 20px;font-size:12px;text-align:center;line-height:1.25}
  .link-row{display:grid;grid-template-columns:1fr;gap:12px}
  .step p{font-size:16px}
  .boundary p,.final p{font-size:17px}
  .process{grid-template-columns:1fr}
  .step{border-right:0;border-bottom:1px solid var(--line)}
  .step:last-child{border-bottom:0}
  .step::after{display:none!important}
}
</style>
</head>
<body>
