  <style>
    :root{--bg:#050505;--paper:#f4f2ec;--muted:#9ea39a;--acid:#caff00;--line:#343734}
    *{box-sizing:border-box}
    html{background:var(--bg);scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--paper);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    .shell{width:min(1180px,calc(100% - 32px));margin:auto}
    header{position:sticky;top:0;z-index:20;background:rgba(5,5,5,.9);backdrop-filter:blur(14px);border-bottom:1px solid #1d201d}
    .head{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{font:950 18px/1 Impact,Haettenschweiler,"Arial Black",sans-serif;letter-spacing:.04em;text-decoration:none}
    .nav{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
    .nav a{font:800 10px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.09em;text-transform:uppercase;text-decoration:none;color:#c7cac3}
    .nav a:hover,.nav a[aria-current="page"]{color:var(--acid)}
    .hero{padding:82px 0 58px;border-bottom:1px solid var(--line)}
    .kicker{color:var(--acid);font:800 11px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.16em;text-transform:uppercase}
    h1{max-width:1000px;margin:16px 0 18px;font:950 clamp(4.2rem,11vw,9rem)/.82 Impact,Haettenschweiler,"Arial Black",sans-serif;letter-spacing:-.05em;text-transform:uppercase}
    h1 span{color:var(--acid)}
    .hero p{max-width:760px;margin:0;color:#bcc0b8;font:18px/1.65 Georgia,"Times New Roman",serif}
    .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;padding:42px 0 70px}
    .card{display:block;text-decoration:none;border:1px solid var(--line);background:#090a09;transition:transform .2s ease,border-color .2s ease}
    .card:hover{transform:translateY(-3px);border-color:#66705e}
    .media{aspect-ratio:16/9;background:#000;overflow:hidden}
    .media video{display:block;width:100%;height:100%;object-fit:cover;background:#000}
    .body{padding:20px 20px 22px}
    .eyebrow{color:var(--acid);font:800 9px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.12em;text-transform:uppercase}
    h2{margin:8px 0 8px;font:950 clamp(2rem,5vw,4rem)/.88 Impact,Haettenschweiler,"Arial Black",sans-serif;letter-spacing:-.035em;text-transform:uppercase}
    .body p{margin:0;color:#9fa49c;font:15px/1.55 Georgia,"Times New Roman",serif}
    .text-card{min-height:320px;display:flex;flex-direction:column;justify-content:flex-end;padding:28px;background:linear-gradient(145deg,#11140f,#050505 62%)}
    .text-card h2{font-size:clamp(2.5rem,5vw,4.7rem)}
    .footer{border-top:1px solid var(--line);padding:28px 0 44px;color:#7f847c;font:700 9px/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.09em;text-transform:uppercase}
    .footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .footer a{text-decoration:none}.footer a:hover{color:var(--acid)}
    @media(max-width:760px){.head{align-items:flex-start;flex-direction:column;padding:18px 0}.nav{gap:14px}.hero{padding:56px 0 42px}.gallery{grid-template-columns:1fr}.shell{width:min(100% - 22px,1180px)}}
  </style>
</head>
